# Copy this file to .env and fill in your own values. NEVER commit .env.

# Provider (the same three variables work for any OpenAI-compatible provider)
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openrouter/free   LLM_API_KEY=<your key>
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1/     LLM_MODEL=gemma3:1b         LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Switches
LLM_STUB=0            # 1 = skip the model, return a hard-coded valid answer (free to build against)
LLM_ENABLED=true      # false = kill switch: skip the model, return the deterministic fallback
PROMPT_VERSION=v1     # which file in prompts/ to use: triage-<version>.md

# Optional tuning
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=600
