# Copy to .env (git-ignored). Never commit .env. Safe placeholder values only.

DATABASE_PATH=data/app.db
PUBLIC_BASE_URL=http://localhost:8000

# mock = deterministic fake geo providers (use this to prove the fallback). real = ip-api.com then ipapi.co.
GEO_MODE=mock

# Dev-only /dev/* endpoints that force failures (geo provider down, email failing) so the probes can be proven.
# Never enable in production.
DEV_TOOLS=1

WORKER_ENABLED=1
MAX_BODY_BYTES=10240

# Token buckets: burst size, then refill per second
RATE_IP_BURST=10
RATE_IP_REFILL_PER_SEC=1
RATE_WIDGET_BURST=60
RATE_WIDGET_REFILL_PER_SEC=5

# Optional: fixed demo API keys for `python -m app.seed` (otherwise random ones are generated into data/demo-keys.json)
DEMO_KEY_A=
DEMO_KEY_B=
